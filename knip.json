{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "include": ["classMembers"],
  "workspaces": {
    "packages/cli": {
      "entry": ["src/cli/index.ts", "bin/binary-entry.ts", "tests/**/testkit/index.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignore": ["tests/fixtures/**"],
      "ignoreDependencies": ["@types/deno"]
    },
    "packages/logger": {
      "project": ["src/**/*.ts"]
    }
  }
}

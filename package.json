{
  "name": "base44",
  "version": "0.0.4",
  "description": "Base44 CLI - Unified interface for managing Base44 applications",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "base44": "./bin/run.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "dev": "./bin/dev.js",
    "start": "./bin/run.js",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "postpack": "rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif manifest"
  },
  "keywords": [
    "base44",
    "cli",
    "command-line"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/base44/cli"
  },
  "dependencies": {
    "@oclif/core": "^4.0.0"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/ejs": "^3.1.5",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/node": "^22.10.5",
    "@types/tar": "^6.1.13",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "globby": "^16.1.0",
    "json5": "^2.2.3",
    "ky": "^1.14.2",
    "lodash.kebabcase": "^4.1.1",
    "oclif": "^4.0.0",
    "p-wait-for": "^6.0.0",
    "tar": "^7.4.3",
    "tsdown": "^0.12.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.0.16",
    "zod": "^4.3.5"
  },
  "oclif": {
    "bin": "base44",
    "dirname": "base44",
    "commands": {
      "strategy": "explicit",
      "target": "./dist/index.js",
      "identifier": "COMMANDS"
    },
    "hooks": {
      "prerun": {
        "target": "./dist/index.js",
        "identifier": "PRERUN_HOOK"
      }
    },
    "topicSeparator": " "
  },
  "engines": {
    "node": ">=20.19.0"
  }
}